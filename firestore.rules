rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny: All paths are locked by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication & Authorization Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role-based Access Control: Admin records are stored in a dedicated, client-read-only collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection: Read-only for authenticated users, non-writable from client SDK
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Connection verification endpoint
    match /test/connection {
      allow read: if true;
    }

    // Users Collection: users/{userId}
    match /users/{userId} {
      // Individual users can only get their own document. User listing is restricted to administrators.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Creation constraints: UID must match Auth UID, no self-granted admin flags
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().email is string
                    && incoming().email.size() <= 150
                    && incoming().fullName is string
                    && incoming().fullName.size() <= 120
                    && !('role' in incoming())
                    && !('isAdmin' in incoming())
                    && !('permissions' in incoming());

      // Update constraints: User cannot change UID or inject role/admin elevation
      allow update: if (isOwner(userId)
                        && incoming().uid == existing().uid
                        && !('role' in incoming())
                        && !('isAdmin' in incoming())
                        && !('permissions' in incoming()))
                    || isAdmin();

      allow delete: if isAdmin();

      // Nested CVs Subcollection: users/{userId}/cvs/{cvId}
      match /cvs/{cvId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
                      && isValidId(cvId)
                      && incoming().cvName is string
                      && incoming().cvName.size() <= 200
                      && incoming().templateId is string;

        allow update: if isOwner(userId)
                      && isValidId(cvId)
                      && incoming().cvName is string
                      && incoming().cvName.size() <= 200;

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Nested Mock Interviews Subcollection: users/{userId}/interviews/{interviewId}
      match /interviews/{interviewId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
                      && isValidId(interviewId)
                      && incoming().career is string
                      && incoming().position is string;

        allow update: if isOwner(userId)
                      && isValidId(interviewId);

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Nested Competency Profile: users/{userId}/profile/{profileId}
      match /profile/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(profileId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Extended User Profiles Collection: user_profiles/{userId}
    match /user_profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Legacy Root Collections (Maintained for seamless migration without data loss)
    match /cv_documents/{cvId} {
      allow get: if isSignedIn() && existing().uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(cvId) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(cvId) && existing().uid == request.auth.uid && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(cvId) && existing().uid == request.auth.uid;
    }

    match /interview_sessions/{sessionId} {
      allow get: if isSignedIn() && existing().uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId) && existing().uid == request.auth.uid && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(sessionId) && existing().uid == request.auth.uid;
    }
  }
}
