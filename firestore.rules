rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test doc for connection check
    match /test/connection {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().email is string
                    && incoming().fullName is string;
      allow update: if isOwner(userId)
                    && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // User Profiles Collection
    match /user_profiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId)
                    && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // CV Documents Collection
    match /cv_documents/{cvId} {
      allow get: if isSignedIn() && existing().uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(cvId)
                    && incoming().uid == request.auth.uid
                    && incoming().cvName is string;
      allow update: if isSignedIn()
                    && isValidId(cvId)
                    && existing().uid == request.auth.uid
                    && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && isValidId(cvId)
                    && existing().uid == request.auth.uid;
    }

    // Mock Interview Sessions Collection
    match /interview_sessions/{sessionId} {
      allow get: if isSignedIn() && existing().uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(sessionId)
                    && incoming().uid == request.auth.uid
                    && incoming().career is string
                    && incoming().position is string;
      allow update: if isSignedIn()
                    && isValidId(sessionId)
                    && existing().uid == request.auth.uid
                    && incoming().uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && isValidId(sessionId)
                    && existing().uid == request.auth.uid;
    }
  }
}
