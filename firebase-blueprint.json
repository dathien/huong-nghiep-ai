{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core account record for authenticated users at users/{userId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "email": { "type": "string", "description": "User email address" },
        "fullName": { "type": "string", "description": "Full display name" },
        "userType": { "type": "string", "description": "Role/Target group: high_school, vocational, college, university, job_seeker" },
        "school": { "type": "string", "description": "School or university name" },
        "major": { "type": "string", "description": "Major of study or specialization" },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["uid", "email", "fullName", "userType"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Extended user profile information and career preferences at user_profiles/{userId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "phone": { "type": "string", "description": "Phone number" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "educationLevel": { "type": "string", "description": "Education stage" },
        "careerGoal": { "type": "string", "description": "Target career goal" },
        "bio": { "type": "string", "description": "Short self-introduction" },
        "targetIndustry": { "type": "string", "description": "Target working industry" },
        "skills": { "type": "array", "description": "List of core skills" },
        "updatedAt": { "type": "string", "description": "Last profile update timestamp" }
      },
      "required": ["uid"]
    },
    "CvDocument": {
      "title": "CvDocument",
      "description": "A saved CV document stored at users/{userId}/cvs/{cvId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "uid": { "type": "string", "description": "Owner user ID" },
        "cvName": { "type": "string", "description": "Name/label of this CV" },
        "templateId": { "type": "string", "description": "Selected template identifier" },
        "targetRole": { "type": "string", "description": "Target job position" },
        "cvData": { "type": "object", "description": "Full structured CV data payload" },
        "photoUrl": { "type": "string", "description": "CV portrait photo link or placeholder" },
        "showPhoto": { "type": "boolean", "description": "Flag whether photo is displayed on CV" },
        "photoShape": { "type": "string", "description": "Photo framing style: circle, rounded, or square" },
        "themeConfig": { "type": "object", "description": "Custom color, font, and section visibility settings" },
        "isDefault": { "type": "boolean", "description": "Whether this is the primary default CV" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modification timestamp" }
      },
      "required": ["uid", "cvName", "templateId", "cvData"]
    },
    "InterviewSession": {
      "title": "InterviewSession",
      "description": "A recorded AI mock interview practice session stored at users/{userId}/interviews/{interviewId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "uid": { "type": "string", "description": "User ID of candidate" },
        "career": { "type": "string", "description": "Field or domain" },
        "position": { "type": "string", "description": "Position applied for" },
        "level": { "type": "string", "description": "Experience level (intern, fresher, junior...)" },
        "questionCount": { "type": "number", "description": "Total question count" },
        "mode": { "type": "string", "description": "Practice mode: voice or text" },
        "status": { "type": "string", "description": "Status: in_progress, completed, abandoned" },
        "score": { "type": "number", "description": "Overall score out of 100" },
        "overallVerdict": { "type": "string", "description": "Summary feedback verdict" },
        "exchanges": { "type": "array", "description": "Questions, user answers, and evaluation details" },
        "strengths": { "type": "array", "description": "Observed candidate strengths" },
        "improvements": { "type": "array", "description": "Areas for candidate improvement" },
        "actionPlan": { "type": "array", "description": "Concrete next steps" },
        "durationSeconds": { "type": "number", "description": "Total duration in seconds" },
        "createdAt": { "type": "string", "description": "Session timestamp" },
        "updatedAt": { "type": "string", "description": "Last modification timestamp" }
      },
      "required": ["uid", "career", "position", "level", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account record tied to their auth UID."
    },
    "/users/{userId}/cvs/{cvId}": {
      "schema": "CvDocument",
      "description": "Subcollection of CVs owned by individual user."
    },
    "/users/{userId}/interviews/{interviewId}": {
      "schema": "InterviewSession",
      "description": "Subcollection of mock interview sessions conducted by the user."
    },
    "/user_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User personal details and preferences."
    },
    "/cv_documents/{cvId}": {
      "schema": "CvDocument",
      "description": "Legacy collection of CVs."
    },
    "/interview_sessions/{sessionId}": {
      "schema": "InterviewSession",
      "description": "Legacy collection of mock interview sessions."
    }
  }
}
